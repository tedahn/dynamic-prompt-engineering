{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "explore-approaches-candidate-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pipeline_id", "candidate_name", "candidate_version", "files", "csv_records", "markdown_records", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "pipeline_id": {"type": "string", "minLength": 1},
    "candidate_name": {"const": "explore-approaches"},
    "candidate_version": {"type": "string", "pattern": "^explore-approaches-v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "csv_records": {"type": "array", "items": {"type": "object"}},
    "markdown_records": {"type": "array", "items": {"type": "object"}},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
