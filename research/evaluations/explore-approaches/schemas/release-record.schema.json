{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable reviewed merge release record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "approval_sha256", "candidate_manifest_sha256", "config_sha256", "pr_record_sha256",
    "base_commit", "head_commit", "pr_url", "merge_commit", "merged_at", "github_actor", "github_evidence", "status", "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "approval_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "candidate_manifest_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "pr_record_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "base_commit": {"pattern": "^[0-9a-f]{40,64}$"},
    "head_commit": {"pattern": "^[0-9a-f]{40,64}$"},
    "pr_url": {"type": "string", "format": "uri"},
    "merge_commit": {"pattern": "^[0-9a-f]{40,64}$"},
    "merged_at": {"type": "string", "format": "date-time"},
    "github_actor": {"type": "string", "minLength": 1},
    "github_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["base_branch", "head_commit", "merge_state_status", "review_decision", "approved_reviewers", "successful_checks", "verified_at", "github_actor"],
      "properties": {
        "base_branch": {"type": "string", "minLength": 1},
        "head_commit": {"pattern": "^[0-9a-f]{40,64}$"},
        "merge_state_status": {"type": ["string", "null"]},
        "review_decision": {"const": "APPROVED"},
        "approved_reviewers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "successful_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "verified_at": {"type": "string", "format": "date-time"},
        "github_actor": {"type": "string", "minLength": 1}
      }
    },
    "status": {"const": "merged"},
    "record_sha256": {"pattern": "^[0-9a-f]{64}$"}
  }
}
