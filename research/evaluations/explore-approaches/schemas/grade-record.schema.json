{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "explore-approaches-grade-record.schema.json",
  "title": "Human-final grouped blind grade and explicit ranking",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "adjudicated", "candidate_grades", "ranking"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "packet_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "adjudicated": {"const": true},
    "candidate_grades": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "dimension_scores", "critical_failure", "hard_gates", "rationale"],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
          "score": {"type": "number", "minimum": 0, "maximum": 4},
          "dimension_scores": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "goal_framing",
              "workspace_grounding",
              "option_distinctness",
              "decision_criteria",
              "counterevidence",
              "recommendation_traceability",
              "reversible_test",
              "concision",
              "uncertainty"
            ],
            "properties": {
              "goal_framing": {"type": "number", "minimum": 0, "maximum": 4},
              "workspace_grounding": {"type": "number", "minimum": 0, "maximum": 4},
              "option_distinctness": {"type": "number", "minimum": 0, "maximum": 4},
              "decision_criteria": {"type": "number", "minimum": 0, "maximum": 4},
              "counterevidence": {"type": "number", "minimum": 0, "maximum": 4},
              "recommendation_traceability": {"type": "number", "minimum": 0, "maximum": 4},
              "reversible_test": {"type": "number", "minimum": 0, "maximum": 4},
              "concision": {"type": "number", "minimum": 0, "maximum": 4},
              "uncertainty": {"type": "number", "minimum": 0, "maximum": 4}
            }
          },
          "critical_failure": {"type": "boolean"},
          "hard_gates": {"type": "object", "minProperties": 6, "additionalProperties": {"type": "boolean"}},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "ranking": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "pattern": "^[0-9a-f]{24}$"}
      }
    }
  }
}
