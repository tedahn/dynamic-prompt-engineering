{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "explore-approaches-promotion-approval.schema.json",
  "title": "Explore Approaches named-human promotion approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "decision",
    "human_approved",
    "approved_by",
    "approved_at",
    "expires_at",
    "candidate_name",
    "candidate_version",
    "candidate_commit",
    "evaluation_completed_at",
    "evaluation_summary_path",
    "evaluation_summary_sha256",
    "holdout_manifest_sha256",
    "thresholds_met",
    "accepted_exceptions",
    "github_repository",
    "github_target_branch",
    "github_pr_url",
    "merged_commit",
    "root_skills_path",
    "canary_plan_path",
    "rollback_tested"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "approval_id": {"type": "string", "minLength": 1},
    "decision": {"const": "promote"},
    "human_approved": {"const": true},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "candidate_name": {"const": "explore-approaches"},
    "candidate_version": {"type": "string", "pattern": "^explore-approaches-v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "evaluation_completed_at": {"type": "string", "format": "date-time"},
    "evaluation_summary_path": {"type": "string", "minLength": 1},
    "evaluation_summary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "holdout_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "thresholds_met": {"const": true},
    "accepted_exceptions": {"type": "array", "items": {"type": "string"}},
    "github_repository": {"const": "https://github.com/tedahn/dynamic-prompt-engineering-in-execution.git"},
    "github_target_branch": {"const": "main"},
    "github_pr_url": {"type": "string", "format": "uri"},
    "merged_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "root_skills_path": {"const": "~/.codex/skills/explore-approaches"},
    "canary_plan_path": {"type": "string", "minLength": 1},
    "rollback_tested": {"const": true},
    "notes": {"type": "string"}
  }
}
