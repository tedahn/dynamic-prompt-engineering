{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verified atomic root installation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "installed_at", "transaction_id", "intent_sha256", "canary_record_sha256",
    "merge_commit", "destination", "file_hashes", "backup", "status", "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "installed_at": {"type": "string", "format": "date-time"},
    "transaction_id": {"pattern": "^[0-9a-f]{32}$"},
    "intent_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "canary_record_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "merge_commit": {"pattern": "^[0-9a-f]{40,64}$"},
    "destination": {"type": "string", "minLength": 1},
    "file_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "backup": {"type": ["string", "null"]},
    "status": {"const": "installed"},
    "record_sha256": {"pattern": "^[0-9a-f]{64}$"}
  }
}
