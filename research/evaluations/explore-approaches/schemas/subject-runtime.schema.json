{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "explore-approaches-subject-runtime.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "provider_id",
    "model_id",
    "settings",
    "settings_sha256",
    "argv",
    "argv_sha256",
    "executable",
    "entrypoint",
    "artifacts",
    "sha256"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "adapter_id": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "settings": {"type": "object"},
    "settings_sha256": {"$ref": "#/$defs/sha256"},
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "argv_sha256": {"$ref": "#/$defs/sha256"},
    "executable": {"$ref": "#/$defs/fileArtifact"},
    "entrypoint": {"$ref": "#/$defs/fileArtifact"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fileArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "kind": {"const": "file"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "directoryArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "file_count", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "kind": {"const": "directory"},
        "file_count": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "oneOf": [
        {"$ref": "#/$defs/fileArtifact"},
        {"$ref": "#/$defs/directoryArtifact"}
      ]
    }
  }
}
