{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "explore-approaches-evidence-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "plan_sha256",
    "plan_design_sha256",
    "holdout_sha256",
    "blind_key_commitment",
    "blind_packet_sha256",
    "blind_map_sha256",
    "artifacts",
    "final_grades_sha256",
    "human_review_sha256",
    "cells",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "plan_design_sha256": {"$ref": "#/$defs/sha256"},
    "holdout_sha256": {"$ref": "#/$defs/sha256"},
    "blind_key_commitment": {"$ref": "#/$defs/sha256"},
    "blind_packet_sha256": {"$ref": "#/$defs/sha256"},
    "blind_map_sha256": {"$ref": "#/$defs/sha256"},
    "final_grades_sha256": {"$ref": "#/$defs/sha256"},
    "human_review_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan",
        "candidate_manifest",
        "holdout_manifest",
        "config",
        "arm_materials",
        "subject_runtime",
        "rubric",
        "blind_packet",
        "blind_map",
        "final_grades",
        "human_review"
      ],
      "properties": {
        "plan": {"$ref": "#/$defs/artifact"},
        "candidate_manifest": {"$ref": "#/$defs/artifact"},
        "holdout_manifest": {"$ref": "#/$defs/artifact"},
        "config": {"$ref": "#/$defs/artifact"},
        "arm_materials": {"$ref": "#/$defs/artifact"},
        "subject_runtime": {"$ref": "#/$defs/artifact"},
        "rubric": {"$ref": "#/$defs/artifact"},
        "blind_packet": {"$ref": "#/$defs/artifact"},
        "blind_map": {"$ref": "#/$defs/artifact"},
        "final_grades": {"$ref": "#/$defs/artifact"},
        "human_review": {"$ref": "#/$defs/artifact"}
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cell_id", "result", "result_sha256", "attempts"],
        "properties": {
          "cell_id": {"type": "string", "minLength": 1},
          "result": {"$ref": "#/$defs/artifact"},
          "result_sha256": {"$ref": "#/$defs/sha256"},
          "attempts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["attempt", "request", "raw_response", "normalized_response", "attempt_record"],
              "properties": {
                "attempt": {"type": "integer", "minimum": 1},
                "request": {"$ref": "#/$defs/artifact"},
                "raw_response": {
                  "anyOf": [
                    {"type": "null"},
                    {"$ref": "#/$defs/artifact"}
                  ]
                },
                "normalized_response": {"$ref": "#/$defs/artifact"},
                "attempt_record": {"$ref": "#/$defs/artifact"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
