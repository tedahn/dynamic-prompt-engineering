{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "explore-approaches-canary-record.schema.json",
  "title": "Fresh-process canary receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "completed_at", "transaction_id", "merge_commit", "status", "result", "record_sha256"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "completed_at": {"type": "string", "format": "date-time"},
    "transaction_id": {"pattern": "^[0-9a-f]{32}$"},
    "merge_commit": {"pattern": "^[0-9a-f]{40,64}$"},
    "status": {"const": "passed"},
    "result": {"type": "object"},
    "record_sha256": {"pattern": "^[0-9a-f]{64}$"}
  }
}
