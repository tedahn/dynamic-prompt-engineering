{
  "schema_version": "1.0",
  "registry_id": "professionalize-prompt-checks-v1",
  "rules": [
    {
      "grader_type": "automated-output-envelope",
      "score_channel": "D",
      "default_weight": 1,
      "status": "implemented-by-runner-adapter-before-run",
      "checks": [
        "exactly_100_words",
        "exactly_50_words",
        "exactly_five_bullets",
        "has_prompt",
        "has_prompt_and_diagnosis",
        "has_prompt_and_result",
        "no_prompt",
        "prompt_only"
      ]
    },
    {
      "grader_type": "fixture-or-trace-adapter",
      "score_channel": "D",
      "default_weight": 2,
      "status": "requires-synthetic-fixture-adapter-before-run",
      "checks": [
        "handles_quoted_comma",
        "only_math_utils_changed",
        "ranking_matches_oracle",
        "recomputes_scores",
        "tests_pass",
        "totals_match_oracle",
        "zero_tool_calls",
        "zero_writes"
      ]
    },
