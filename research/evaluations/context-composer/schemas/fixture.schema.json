{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context composer evaluation fixture",
  "type": "object",
  "required": ["fixture_id", "family", "query", "max_tokens", "allowed_scopes", "signals", "items", "expected"],
  "properties": {
    "fixture_id": {"type": "string", "pattern": "^CC-[0-9]{3}$"},
    "family": {"type": "string", "minLength": 1},
    "query": {"type": "string", "minLength": 1},
    "max_tokens": {"type": "integer", "minimum": 1},
    "allowed_scopes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "signals": {
      "type": "object",
      "required": ["needs_clarification", "update_sensitive"],
      "properties": {
        "needs_clarification": {"type": "boolean"},
        "update_sensitive": {"type": "boolean"},
        "allow_stale_history": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "authority", "scope", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "retrieval_terms": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "timestamp": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "enum": ["canonical", "primary", "secondary", "untrusted"]},
          "scope": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["current", "undated", "stale", "superseded"]},
          "depends_on": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "injection": {"type": "boolean"},
          "security": {
            "type": "object",
            "required": ["producer", "trust", "sensitivity", "content_type"],
            "properties": {
              "producer": {"type": "string", "enum": ["context-fixture-author-v1"]},
              "trust": {"type": "string", "enum": ["trusted", "untrusted"]},
              "sensitivity": {"type": "string", "enum": ["public", "internal", "confidential", "secret"]},
              "content_type": {"type": "string", "enum": ["evidence", "instruction"]}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "expected": {
      "type": "object",
      "required": ["required_ids", "forbidden_ids", "stale_ids", "route"],
      "properties": {
        "required_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "forbidden_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "stale_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "route": {"type": "string", "enum": ["clarify", "full_context", "composed"]},
        "before": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
