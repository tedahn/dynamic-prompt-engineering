{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "promotion-approval.schema.json",
  "title": "Named-human context promotion approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "decision",
    "human_approved",
    "approved_by",
    "approved_at",
    "expires_at",
    "epoch_id",
    "summary_sha256",
    "candidate_snapshot_id",
    "expected_active_snapshot_id",
    "expected_active_version",
    "holdout_manifest_sha256",
    "canary_evidence_sha256",
    "rollback_evidence_sha256",
    "fresh_holdout_attested",
    "grader_independence_attested",
    "canary_completed",
    "rollback_tested"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "approval_id": {"type": "string", "minLength": 1},
    "decision": {"const": "promote"},
    "human_approved": {"const": true},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "epoch_id": {"type": "string", "minLength": 1},
    "summary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_snapshot_id": {"type": "string", "minLength": 1},
    "expected_active_snapshot_id": {"type": "string", "minLength": 1},
    "expected_active_version": {"type": "integer", "minimum": 1},
    "holdout_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canary_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rollback_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fresh_holdout_attested": {"const": true},
    "grader_independence_attested": {"const": true},
    "canary_completed": {"const": true},
    "rollback_tested": {"const": true},
    "notes": {"type": "string"}
  }
}
