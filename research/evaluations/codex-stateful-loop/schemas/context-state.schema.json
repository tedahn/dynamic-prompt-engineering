{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-state.schema.json",
  "title": "Versioned agent context state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "parent_snapshot_id", "revision", "status", "owner", "created_at", "policy_version", "entries"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "snapshot_id": {"type": "string", "pattern": "^CTX-STATE-[A-Z0-9-]+$"},
    "parent_snapshot_id": {"type": ["string", "null"]},
    "revision": {"type": "integer", "minimum": 0},
    "status": {"enum": ["accepted", "candidate", "superseded", "rolled-back"]},
    "owner": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by_event": {"type": ["string", "null"]},
    "policy_version": {"type": "string", "minLength": 1},
    "rollback_snapshot_id": {"type": ["string", "null"]},
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "kind", "content", "scope", "source_event_ids", "evidence_state", "confidence", "priority", "sensitivity", "allowed_surfaces", "authority_effect", "owner", "valid_from", "expires_at", "refresh_trigger", "status", "supersedes"],
      "properties": {
        "entry_id": {"type": "string", "pattern": "^CTX-[A-Z0-9-]+$"},
        "kind": {"enum": ["fact", "preference", "procedure", "lesson", "constraint"]},
        "content": {"type": "string", "minLength": 1, "maxLength": 2000},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domains", "task_tags"],
          "properties": {
            "domains": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "task_tags": {"type": "array", "items": {"type": "string"}}
          }
        },
        "source_event_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evidence_state": {"enum": ["Grounded fact", "Corroborated", "Experimental", "Looks believable", "Forecast/opinion", "Unknown"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "priority": {"type": "integer", "minimum": 0, "maximum": 100},
        "sensitivity": {"enum": ["public", "internal", "restricted"]},
        "allowed_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "authority_effect": {"const": "none"},
        "owner": {"type": "string", "minLength": 1},
        "valid_from": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "refresh_trigger": {"type": ["string", "null"]},
        "status": {"enum": ["active", "superseded", "retired"]},
        "supersedes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
