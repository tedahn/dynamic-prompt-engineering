{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-approval.schema.json",
  "title": "Scoped provider-backed run approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "approval_id", "approver_type", "approved_by", "approved_at", "expires_at", "epoch_id", "plan_sha256", "runtime_profile_sha256", "maximum_cells", "cell_ids", "provider_processing_acknowledged", "allowed_stage"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "approval_id": {"type": "string", "minLength": 1},
    "approver_type": {"const": "human"},
    "approved_by": {"type": "string", "minLength": 3},
    "approved_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "epoch_id": {"type": "string"},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "runtime_profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "maximum_cells": {"type": "integer", "minimum": 1, "maximum": 500},
    "cell_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "provider_processing_acknowledged": {"const": true},
    "allowed_stage": {"enum": ["smoke", "pilot", "full"]},
    "notes": {"type": "string"}
  }
}
